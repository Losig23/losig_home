# Copy to .env and fill in your values. Never commit .env.
# CalorieNinjas (API Ninjas) free tier — sign up with any email at https://api-ninjas.com
API_NINJAS_KEY=your_api_key
# Signs login session cookies (required outside tests).
# Generate one with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me-in-production
# Database. Local dev uses SQLite by default; set this to your Neon Postgres
# URL for production (Render dashboard overrides render.yaml's default).
# SQLAlchemy needs the postgresql:// scheme; Render/Neon may give
# postgres://... — config.py normalizes it automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Meal photo storage: "local" (default, instance/uploads/) or "r2"
# (Cloudflare R2 — required on Render, whose filesystem is ephemeral).
# STORAGE_BACKEND=local
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=losig-home-photos
# Last.fm read-only integration (weekly charts + recent tracks, display only).
# Free API account at https://www.last.fm/api/account/create — no OAuth needed.
# Unset -> the music section is omitted everywhere, nothing breaks.
# LASTFM_API_KEY=your_lastfm_api_key
# LASTFM_USERNAME=your_lastfm_username
